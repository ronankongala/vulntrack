server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend at request time so nginx starts even before the Service's DNS entry exists.
    # nginx's resolver ignores search domains, so BACKEND_URL must be fully qualified.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routing: unknown paths fall back to the SPA entry point.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
